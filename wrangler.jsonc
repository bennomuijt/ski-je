{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "ski-je",
  "main": "src/index.js",
  "compatibility_date": "2026-11-20",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "GROUPS",
        "class_name": "SkiGroup"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "SkiGroup"
      ]
    }
  ],
  "observability": {
    "enabled": true
  }
}
