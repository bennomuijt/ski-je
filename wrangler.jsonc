{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "ski-je",
  "main": "src/index.js",
  "compatibility_date": "2026-11-20",
  "build": {
    "command": "npm run build:release"
  },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "GROUPS",
        "class_name": "SkiGroup"
      },
      {
        "name": "PHOTOS",
        "class_name": "SkiPhotoBoard"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "SkiGroup"
      ]
    },
    {
      "tag": "v2",
      "new_sqlite_classes": [
        "SkiPhotoBoard"
      ]
    }
  ],
  "observability": {
    "enabled": true
  }
}
